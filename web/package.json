{
    "name": "ente-web",
    "version": "0.0.0",
    "private": true,
    "description": "Ente web apps and packages..",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo build",
        "build:accounts": "turbo build --filter=accounts",
        "build:albums": "turbo build --filter=albums",
        "build:auth": "turbo build --filter=auth",
        "build:cast": "turbo build --filter=cast",
        "build:embed": "turbo build --filter=embed",
        "build:ensu": "turbo build --filter=ensu",
        "build:locker": "turbo build --filter=locker",
        "build:memories": "turbo build build:post --filter=memories",
        "build:paste": "turbo build build:post --filter=paste",
        "build:payments": "turbo build --filter=payments",
        "build:photos": "turbo build --filter=photos",
        "build:share": "turbo build build:post --filter=share",
        "build:twoof3": "turbo build --filter=twoof3",
        "build:wasm": "turbo build --filter=ente-wasm",
        "dev": "turbo dev --filter=photos",
        "dev:accounts": "turbo dev --filter=accounts",
        "dev:albums": "turbo dev --filter=albums",
        "dev:auth": "turbo dev --filter=auth",
        "dev:cast": "turbo dev --filter=cast",
        "dev:embed": "turbo dev --filter=embed",
        "dev:ensu": "turbo dev --filter=ensu",
        "dev:locker": "turbo dev --filter=locker",
        "dev:memories": "turbo dev --filter=memories",
        "dev:paste": "turbo dev --filter=paste",
        "dev:payments": "turbo dev --filter=payments",
        "dev:photos": "turbo dev --filter=photos",
        "dev:share": "turbo dev --filter=share",
        "dev:twoof3": "turbo dev --filter=twoof3",
        "lint": "turbo lint tsc && prettier --check --log-level warn .",
        "lint-fix": "turbo lint tsc && prettier --write --log-level warn .",
        "test": "turbo test --filter=ente-wasm --filter=ente-contacts-web"
    },
    "resolutions": {
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "base-x": "5.0.1"
    },
    "devDependencies": {
        "eslint": "9.30.1",
        "prettier": "3.6.2",
        "turbo": "^2.5.4",
        "typescript": "5.8.3"
    },
    "packageManager": "yarn@1.22.22"
}
